# Copy to .env.development and point it at an isolated Supabase project plus Stripe test mode.
# Never put production values in this file.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-test-project-anon-key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
